# These two blocks are INDEPENDENT live dependencies. You can run either alone or both —
# all three are valid setups, but each leaves different things unverifiable. See
# docs/verification.md, "Which live services to run", before reporting a manual check.

# Backend API — use your machine's LAN IP instead of localhost when testing on a physical
# device via Expo Go (localhost won't resolve from the phone to your dev machine). Web and
# simulators can use localhost directly.
# Start it in the backend repo: `docker compose up` (Postgres/Redis/MinIO), then `npm run dev`.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Supabase Auth (Constitution Principle III). Leave these empty and there is no session, so
# the KYC gate redirects EVERY authenticated route to /login — including screens whose content
# is entirely local. An unreachable screen can't be smoke-checked.
# Running both? The backend's AUTH_PROVIDER_MODE must point at this same Supabase project —
# left at "mock" it mints a user this app can never sign in against.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
